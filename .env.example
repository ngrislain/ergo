# With no S3_BUCKET the server persists to ./data.
ERGO_BIND=127.0.0.1:3000
ERGO_DATA_DIR=./data
# S3_BUCKET=your-bucket
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# AWS_ACCESS_KEY_ID=your-scaleway-access-key
# AWS_SECRET_ACCESS_KEY=your-scaleway-secret-key
# S3_PREFIX=ergo
# LDRAW_DIR=/absolute/path/to/ldraw
# LDRAW_BASE_URL=https://library.ldraw.org/library/official
# ERGO_ASSET_FETCH=1
# ERGO_API_URL=http://127.0.0.1:3000
# ERGO_GROUND_SOURCE=osm
# ERGO_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# ERGO_MAP_PROVIDER=OpenStreetMap Carto
# ERGO_MAP_USER_AGENT=Ergo/0.1 (+your-public-contact-url)
# ERGO_MAP_ATTRIBUTION=© OpenStreetMap contributors
# ERGO_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# ERGO_STATIC_POSITION_EPSILON=0.0001
# ERGO_STATIC_ROTATION_EPSILON=0.0001
# ERGO_STATIC_FORCE_EPSILON_N=0.000001
# ERGO_STATIC_TORQUE_EPSILON_NM=0.00000001
# ERGO_ORIGIN_LAT=48.8566
# ERGO_ORIGIN_LON=2.3522
# ERGO_ARCSECONDS_PER_BLOCK=1
# Google OAuth web client; leave unset for the local development account.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# ERGO_SESSION_SECRET=at-least-32-random-characters
# ERGO_PUBLIC_URL=http://127.0.0.1:3000
# Server-owned, sourced connector-capacity measurements; needed to publish joints.
# ERGO_CONNECTION_MEASUREMENTS=/absolute/path/to/connector-measurements.json
