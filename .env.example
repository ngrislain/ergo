# With no S3_BUCKET the server persists to ./data.
ERGO_BIND=127.0.0.1:3000
ERGO_DATA_DIR=./data
# S3_BUCKET=your-bucket
# S3_ENDPOINT=https://s3.fr-par.scw.cloud
# S3_REGION=fr-par
# AWS_ACCESS_KEY_ID=your-scaleway-access-key
# AWS_SECRET_ACCESS_KEY=your-scaleway-secret-key
# S3_PREFIX=ergo
# Hosted v0.4.0 requires the one migrated sandbox. Leave unset for local bootstrap.
# ERGO_COMMON_WORLD_ID=fde184c4-222b-4a16-8a1f-c320da8a2f35
# ERGO_WORLD_PREFIX=world
# ERGO_ASSET_LIBRARY_DIR=/absolute/path/to/source-library
# ERGO_ASSET_SOURCE_URL=https://library.ldraw.org/library/official
# ERGO_ASSET_FETCH=1
# ERGO_API_URL=http://127.0.0.1:3000
# Optional MCP process environment (MCP does not automatically load .env).
# ERGO_PUBLISH_URL=https://your-ergo-server.example
# ERGO_PUBLISH_TOKEN_FILE=/absolute/path/to/mcp-delegation-token
# ERGO_PUBLISH_TOKEN can supply the delegation directly instead of a file.
# ERGO_GROUND_SOURCE=satellite
# ERGO_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# ERGO_MAP_PROVIDER=Esri World Imagery (satellite/aerial)
# ERGO_MAP_USER_AGENT=Ergo/0.1 (+your-public-contact-url)
# ERGO_MAP_ATTRIBUTION=Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community
# ERGO_MAP_ATTRIBUTION_URL=https://www.arcgis.com/home/item.html?id=10df2279f9684e4a9f6a7f08febac2a9
# ERGO_STATIC_POSITION_EPSILON=0.0001
# ERGO_STATIC_ROTATION_EPSILON=0.0001
# ERGO_STATIC_FORCE_EPSILON_N=0.000001
# ERGO_STATIC_TORQUE_EPSILON_NM=0.00000001
# ERGO_ORIGIN_LAT=48.8566
# ERGO_ORIGIN_LON=2.3522
# ERGO_ARCSECONDS_PER_BLOCK=1
# Google OAuth web client; leave unset for the local development account.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# ERGO_SESSION_SECRET=at-least-32-random-characters
# Browser-facing origin; required to match exactly with Google or a non-loopback URL.
# Local development also accepts same-origin loopback names/ports with the same scheme.
# ERGO_PUBLIC_URL=http://127.0.0.1:3000
# Server-owned connector capacities and optional sourced non-standard part masses/bounds.
# ERGO_CONNECTION_MEASUREMENTS=/absolute/path/to/connector-measurements.json
# Per-edit budgets only; shared worlds have no aggregate piece/byte size limit.
# ERGO_SHARED_WORKING_PIECES=5000
# ERGO_SHARED_WORKING_BYTES=134217728
# Per-user shared-world edit pacing; paid entitlement bypasses only this budget.
# ERGO_EDIT_BRICKS_PER_PERIOD=5000
# ERGO_EDIT_PERIOD_SECONDS=86400
# Temporary disk metadata for streaming garbage collection; directory must exist.
# ERGO_GC_SCRATCH_DIR=/absolute/path/to/gc-scratch
# Opt-in group publication after benchmarking the endpoint; queue/window are bounded.
# ERGO_SHARED_GROUP_COMMIT=0
# One poll per actively subscribed world per server process (50..60000 ms).
# ERGO_SHARED_EVENT_POLL_MS=1000
