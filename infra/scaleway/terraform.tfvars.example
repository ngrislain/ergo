# Copy to terraform.tfvars. Supply secrets as TF_VAR_* environment variables.
project_id = "11111111-1111-4111-8111-111111111111"
image      = "rg.fr-par.scw.cloud/YOUR-REGISTRY/ergo:IMMUTABLE-BUILD-TAG"

domain_name   = "ergosandbox.com"
bucket_name   = "ergo"
bucket_region = "fr-par"
s3_prefix     = "ergo"
common_world_id = "fde184c4-222b-4a16-8a1f-c320da8a2f35"
world_prefix = "world"
max_scale     = 1
# Increase only for diagnosed long operations; client deadlines are independent.
request_timeout_seconds = 300
free_bricks_per_period = 5000
edit_period_seconds   = 86400

google_client_id = "YOUR-CLIENT.apps.googleusercontent.com"

# Set false for DNS hosted outside Scaleway and create an apex ALIAS/flattened
# CNAME to the dns_alias_target output yourself before enabling domain binding.
manage_dns = true
